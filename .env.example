# ============================================================
# Potential Tools v3.0 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# === 数据库 ===
# PostgreSQL 连接字符串（生产环境必填，留空则使用 SQLite）
# Railway: 在插件中创建 PostgreSQL 后会自动提供此变量
# DATABASE_URL=postgresql://user:password@host:port/dbname

# === 飞书 OAuth ===
# 在 https://open.feishu.cn 创建应用获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_REDIRECT_URI=https://your-domain.com/auth/feishu/callback

# === Google OAuth ===
# 在 https://console.cloud.google.com 创建 OAuth 凭据
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# === Session 安全 ===
# 生成随机字符串: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_random_string

# === AI 配置（阿里云百炼 DashScope） ===
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_MODEL=qwen-turbo

# === 其他 ===
# 访客模式（本地开发设为 true，生产环境建议 false）
ALLOW_GUEST=true
# 服务端口
PORT=5001
# SQLite 数据目录（仅本地开发，DATABASE_URL 为空时生效）
DB_DIR=data
